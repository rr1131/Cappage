# Server-only Neon PostgreSQL connection string; use an isolated development DB.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Existing Cognito configuration (public identifiers, not secrets).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
NEXT_PUBLIC_COGNITO_CLIENT_ID=YOUR_APP_CLIENT_ID

# Optional server overrides; otherwise the public identifiers above are reused.
# COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
# COGNITO_CLIENT_ID=YOUR_APP_CLIENT_ID

# Odds are synthetic by default; no upstream key or subscription is needed.
ODDS_PROVIDER=mock
# To ingest real NFL quotes, select the-odds-api and supply your own server-only key.
# ODDS_API_KEY=YOUR_ODDS_API_KEY
# Account owner confirmed credits reset on the first of each month at 00:00 UTC.
# This fixed anchor repeats monthly; do not change it each month.
ODDS_BILLING_ANCHOR=2027-11-01T00:00:00Z

# Demand only: page entry/manual refresh or odds:sync; no background polling.
# Paid attempts remain at least 6 hours apart, including failures.
ODDS_REFRESH_SECONDS=21600
# Local monthly cap and Eastern-calendar-day paid attempt limit; can only tighten.
# All instances using this provider allocation must share the same database.
ODDS_MONTHLY_CREDIT_CAP=300
ODDS_DAILY_PAID_REFRESH_LIMIT=3
# Quotes older than this are labeled stale, regardless of refresh frequency.
ODDS_FRESH_SECONDS=300
# Expired quotes are hidden after 24 hours, or earlier at kickoff.
ODDS_MAX_AGE_SECONDS=86400
# Preserve this many upstream credits; refreshes may stop before exhaustion.
ODDS_CREDIT_RESERVE=25

# Integration tests use a separate disposable PostgreSQL database, never DATABASE_URL.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rkvtk_test
